@model Proyecto.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-wrap">
    <section class="form-card login-card">
        <p class="eyebrow">Programas Sociales</p>
        <h1>Iniciar sesión</h1>
        <p class="secondary-copy">Ingresa tus credenciales para continuar.</p>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="mb-3">
                <label asp-for="Usuario" class="form-label">Usuario</label>
                <input asp-for="Usuario" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Usuario" class="validation-message"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Contrasena" class="form-label">Contraseña</label>
                <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Contrasena" class="validation-message"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
