@model Proyecto.Modules.Beneficiarios.Models.ResumenBeneficiariosViewModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="page-heading home-heading">
    <div>
        <p class="eyebrow">Programas Sociales</p>
        <h1>Resumen de beneficiarios</h1>
        <p class="secondary-copy">Información de inscripciones activas.</p>
    </div>
</section>

<section class="summary-grid" aria-label="Resumen de beneficiarios activos">
    <article class="summary-card summary-total">
        <p class="summary-label">Beneficiarios activos</p>
        <p class="summary-number">@Model.TotalActivos</p>
        <p class="secondary-copy">Total registrado</p>
    </article>
    @foreach (var comite in Model.PorComite)
    {
        <article class="summary-card">
            <p class="summary-label">Comité</p>
            <h2>@comite.Comite</h2>
            <p class="summary-number">@comite.Total</p>
            <p class="secondary-copy">Beneficiarios activos</p>
        </article>
    }
</section>

@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-controller="Beneficiarios" asp-action="Index" class="btn btn-primary home-action">Ver beneficiarios</a>
}
