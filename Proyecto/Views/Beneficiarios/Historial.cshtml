@model Proyecto.Modules.Beneficiarios.Models.HistorialBeneficiarioViewModel
@{
    ViewData["Title"] = "Historial de cambios";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Beneficiarios</p>
        <h1>Historial de cambios</h1>
        <p class="secondary-copy">@Model.Beneficiario.Nombres @Model.Beneficiario.Apellidos · DNI @Model.Beneficiario.Dni</p>
    </div>
    <a asp-action="Index" class="btn btn-quiet">Volver a beneficiarios</a>
</section>

<section class="history-list" aria-label="Cambios registrados">
    @if (Model.Cambios.Count == 0)
    {
        <p class="empty-state">No hay cambios registrados.</p>
    }
    @foreach (var cambio in Model.Cambios)
    {
        <article class="history-item">
            <div class="history-heading">
                <strong>@cambio.Usuario</strong>
                <time class="secondary-copy" datetime="@cambio.Fecha.ToString("O")">
                    @cambio.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </time>
            </div>
            <p class="history-reason">@cambio.Motivo</p>
            <span class="secondary-copy">@(cambio.Operacion switch
            {
                "Actualizacion" => "Actualización",
                "Inactivacion" => "Inactivación",
                _ => cambio.Operacion
            })</span>
        </article>
    }
</section>
