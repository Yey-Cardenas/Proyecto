@model Proyecto.Modules.Beneficiarios.Models.BeneficiarioFormViewModel
@{
    ViewData["Title"] = "Registrar beneficiario";
}

<h1 class="h3 mb-3">Registrar beneficiario</h1>
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<p class="text-muted">Los campos marcados con * son obligatorios.</p>

<form asp-action="Create" method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="Beneficiario.Dni" class="form-label">DNI *</label>
        <input asp-for="Beneficiario.Dni" class="form-control" inputmode="numeric" maxlength="8" required />
        <span asp-validation-for="Beneficiario.Dni" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Beneficiario.ComiteId" class="form-label">Comité *</label>
        <select asp-for="Beneficiario.ComiteId" asp-items="Model.Comites" class="form-select" required>
            <option value="">Seleccione un comité</option>
        </select>
        <span asp-validation-for="Beneficiario.ComiteId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Beneficiario.Nombres" class="form-label">Nombres *</label>
        <input asp-for="Beneficiario.Nombres" class="form-control" required />
        <span asp-validation-for="Beneficiario.Nombres" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Beneficiario.Apellidos" class="form-label">Apellidos *</label>
        <input asp-for="Beneficiario.Apellidos" class="form-control" required />
        <span asp-validation-for="Beneficiario.Apellidos" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Beneficiario.Direccion" class="form-label">Dirección (opcional)</label>
        <input asp-for="Beneficiario.Direccion" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Registrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
