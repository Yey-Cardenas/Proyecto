@model Proyecto.Modules.Beneficiarios.Models.BeneficiariosIndexViewModel
@{
    ViewData["Title"] = "Beneficiarios";
}

<section class="page-heading">
    <div>
        <h1>Beneficiarios</h1>
        <p class="secondary-copy">@Model.Total registro(s)</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Registrar beneficiaria</a>
</section>

@if (TempData["Error"] is string error)
{
    <div class="notice" role="alert">@error</div>
}
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="notice" role="status">@mensaje</div>
}

<form asp-action="Index" method="get" class="search-row">
    <label for="dni" class="visually-hidden">Buscar por DNI</label>
    <div class="search-pill">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="10.8" cy="10.8" r="6.8"></circle>
            <path d="m16 16 5 5"></path>
        </svg>
        <input id="dni" name="dni" value="@Model.Dni" inputmode="numeric" maxlength="8"
               placeholder="Buscar por DNI" aria-label="Buscar por DNI" />
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
    @if (!string.IsNullOrEmpty(Model.Dni))
    {
        <a asp-action="Index" class="clear-search">Limpiar búsqueda</a>
    }
</form>

<div class="beneficiary-list">
    @if (Model.Beneficiarios.Count == 0)
    {
        <div class="empty-state">No se encontraron beneficiarios.</div>
    }
    @foreach (var beneficiario in Model.Beneficiarios)
    {
        <article class="beneficiary-card">
            <div class="beneficiary-main">
                <div class="beneficiary-title-row">
                    <h2>@beneficiario.Nombres @beneficiario.Apellidos</h2>
                    <span class="status-tag">@(beneficiario.Activo ? "Activo" : "Inactivo")</span>
                </div>
                <div class="beneficiary-meta">
                    <div><span class="meta-label">DNI</span><span>@beneficiario.Dni</span></div>
                    <div><span class="meta-label">Comité</span><span>@beneficiario.Comite.Nombre</span></div>
                </div>
            </div>
            <div class="beneficiary-actions">
                <a class="btn btn-quiet btn-sm" asp-action="Historial" asp-route-id="@beneficiario.Id">Historial</a>
                @if (beneficiario.Activo)
                {
                    <a class="btn btn-quiet btn-sm" asp-action="Edit" asp-route-id="@beneficiario.Id">Editar</a>
                    <form asp-action="Inactivar" asp-route-id="@beneficiario.Id" method="post" class="deactivate-form">
                        <input name="Motivo" aria-label="Motivo de inactivación" placeholder="Motivo obligatorio"
                               maxlength="500" required />
                        <button type="submit" class="btn btn-quiet btn-sm">Inactivar</button>
                    </form>
                }
            </div>
        </article>
    }
</div>

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación de beneficiarios" class="pagination-wrap">
        <a class="page-control @(Model.Pagina <= 1 ? "disabled" : "")"
           asp-action="Index" asp-route-dni="@Model.Dni" asp-route-page="@(Model.Pagina - 1)">Anterior</a>
        <span class="pagination-label">Página @Model.Pagina de @Model.TotalPaginas</span>
        <a class="page-control @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")"
           asp-action="Index" asp-route-dni="@Model.Dni" asp-route-page="@(Model.Pagina + 1)">Siguiente</a>
    </nav>
}
