@model Proyecto.Modules.Beneficiarios.Models.BeneficiariosIndexViewModel
@{
    ViewData["Title"] = "Beneficiarios";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Beneficiarios</h1>
        <p class="text-muted mb-0">@Model.Total registro(s)</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Registrar beneficiario</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-5">
        <label for="dni" class="form-label">Buscar por DNI</label>
        <input id="dni" name="dni" value="@Model.Dni" class="form-control" inputmode="numeric" maxlength="8" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th scope="col">DNI</th>
                <th scope="col">Nombres</th>
                <th scope="col">Apellidos</th>
                <th scope="col">Comité</th>
                <th scope="col">Estado</th>
                <th scope="col"><span class="visually-hidden">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Beneficiarios.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron beneficiarios.</td></tr>
        }
        @foreach (var beneficiario in Model.Beneficiarios)
        {
            <tr>
                <td>@beneficiario.Dni</td>
                <td>@beneficiario.Nombres</td>
                <td>@beneficiario.Apellidos</td>
                <td>@beneficiario.Comite.Nombre</td>
                <td>
                    <span class="badge @(beneficiario.Activo ? "text-bg-success" : "text-bg-secondary")">
                        @(beneficiario.Activo ? "Activo" : "Inactivo")
                    </span>
                </td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Historial" asp-route-id="@beneficiario.Id">Historial</a>
                    @if (beneficiario.Activo)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@beneficiario.Id">Editar</a>
                        <form asp-action="Inactivar" asp-route-id="@beneficiario.Id" method="post" class="d-inline-flex gap-1">
                            <input name="Motivo" class="form-control form-control-sm" aria-label="Motivo de inactivación"
                                   placeholder="Motivo obligatorio" maxlength="500" required />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Inactivar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación de beneficiarios">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-dni="@Model.Dni" asp-route-page="@(Model.Pagina - 1)">Anterior</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Página @Model.Pagina de @Model.TotalPaginas</span></li>
            <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-dni="@Model.Dni" asp-route-page="@(Model.Pagina + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
